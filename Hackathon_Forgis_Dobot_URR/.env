# ── Active Driver Profiles ──────────────────────────────────
# Comma-separated list of Docker driver profiles to start alongside backend/frontend.
# Available profiles: ur, dobot
COMPOSE_PROFILES=ur

# ── UR Robot Configuration ──────────────────────────────────
# ROBOT_IP=192.168.0.101   # UR3
ROBOT_IP=192.168.163.11    # UR5e
UR_TYPE=ur5e
# The host IP that the robot can reach (for External Control reverse connection)
REVERSE_IP=192.168.163.54
# TCP offset: x,y,z,rx,ry,rz in meters and radians
ROBOT_TCP_OFFSET=0,0,0,0,0,0

# ── DOBOT Nova 5 ────────────────────────────────────────────
DOBOT_IP=192.168.163.11
# Active robot type: ur | dobot  (also update COMPOSE_PROFILES accordingly)
ROBOT_TYPE=ur

# ── Pneumatic Gripper ───────────────────────────────────────
GRIPPER_OPEN_PIN=1
GRIPPER_CLOSE_PIN=2

# ── ROS 2 ───────────────────────────────────────────────────
ROS_DOMAIN_ID=0

# ── Camera / Vision ─────────────────────────────────────────
# Camera mode: "bridge" for Windows (camera_server.py runs on host,
# backend connects via WebSocket). This is the only mode that works
# on Windows since Docker Desktop cannot pass USB cameras to containers.
#
# To start the camera server on Windows:
#   cd assets/camera_server
#   pip install opencv-python websockets numpy
#   python camera_server.py --mode uvc
CAMERA_INPUT_MODE=bridge
CAMERA_BRIDGE_HOST=host.docker.internal
CAMERA_BRIDGE_PORT=8765
YOLO_MODEL=/app/weights/roboflow_logistics.pt

# ── AI endpoints ────────────────────────────────────────────
GEMINI_API_KEY=
AI_PROVIDER=gemini
